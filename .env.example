# Get a free key at https://the-odds-api.com (500 credits/month on the free plan)
ODDS_API_KEY=

# Free Kaggle account -> Settings -> API -> "Create New Token" (fresh daily ATP results + odds)
KAGGLE_API_TOKEN=

# OpenRouter (https://openrouter.ai/keys): the news signal (news.py) asks an LLM to label injury/illness/withdrawal
